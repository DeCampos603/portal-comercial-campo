# Copie este arquivo para `.env` na RAIZ do projeto e preencha.
#
# 🔴 O `.env` NUNCA é versionado (já está no .gitignore).
#    Nunca cole estes valores em chat, e-mail ou issue.

# ---------------------------------------------------------------------
# Supabase → Settings → API
# ---------------------------------------------------------------------

# URL do projeto
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Chave PUBLISHABLE (antiga "anon"). Pública por design — é a que vai no
# frontend também. Só enxerga o que o RLS permitir.
SUPABASE_PUBLISHABLE_KEY=eyJhbGci...

# Chave SECRET (service_role). Ignora o RLS por completo.
# Usada só pelos scripts locais e pelo GitHub Actions. JAMAIS no frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ---------------------------------------------------------------------
# Seu uuid de representante
# Supabase → Authentication → Users (depois de entrar com o Google 1×)
# ---------------------------------------------------------------------
REPRESENTANTE_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------
# Sincronização de preços (o mesmo valor vai nos GitHub Secrets)
# CSV publicado da aba `Precos` do Google Sheets
# ---------------------------------------------------------------------
SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-.../pub?gid=0&single=true&output=csv

# ---------------------------------------------------------------------
# OPCIONAL — só para testar_rls.py
# JWT de uma conta de teste que NÃO está na tabela `representantes`.
# É o teste mais importante: pega a policy `using (true)`.
# Como obter: instruções aparecem ao rodar testar_rls.py sem esta variável.
# ---------------------------------------------------------------------
# TOKEN_ESTRANHO=eyJhbGci...

# ---------------------------------------------------------------------
# Geocodificação — o Nominatim (OpenStreetMap) exige um e-mail real
# identificável em cada requisição. É como eles contatam quem abusa.
# ---------------------------------------------------------------------
NOMINATIM_CONTATO=seu@email.com
